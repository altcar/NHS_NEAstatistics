{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nhs-ne-astatistics",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mazerunner-db",
      "database_id": "82aa474b-588d-40b0-9d17-2d7e7f34b2d4",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
